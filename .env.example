# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: Server-side Instagram session cookie ("sessionid") to enable authenticated
# Instagram Stories, Highlights, and higher-rate Profile/Post extraction via Instaloader.
INSTAGRAM_SESSION_ID=""
# Optional: Account username matching INSTAGRAM_SESSION_ID (speeds up Instaloader session init).
INSTAGRAM_USERNAME=""

# Optional: Custom Python executable path if not using the project .venv/bin/python.
PYTHON_BIN=""

# Optional: Server-side RapidAPI credentials for an Instagram media scraper connector
# (e.g., instagram-scraper-api2 or similar RapidAPI host) to unlock Stories & Highlights.
INSTAGRAM_RAPIDAPI_KEY=""
INSTAGRAM_RAPIDAPI_HOST=""


